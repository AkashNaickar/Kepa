# ── CockroachDB ──────────────────────────────────────────────────────
# Connection string for direct SQL access (psycopg2, etc.)
# Format: postgresql://user:password@host:26257/database?sslmode=verify-full
DATABASE_URL=postgresql://your_user:your_password@your-cluster.cockroachlabs.cloud:26257/defaultdb?sslmode=verify-full

# CockroachDB Managed MCP Server endpoint
# Found in your CockroachDB Cloud dashboard under "MCP Server"
COCKROACH_MCP_ENDPOINT=https://your-cluster.cockroachlabs.cloud/mcp

# ── AWS ──────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# Bedrock model ID for embeddings (1536 dimensions)
# Options: amazon.titan-embed-text-v1, cohere.embed-english-v3
BEDROCK_MODEL_ID=amazon.titan-embed-text-v1

# Bedrock model ID for summarization (text generation)
# Options: amazon.titan-text-express-v1, anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_SUMMARY_MODEL_ID=amazon.titan-text-express-v1

# S3 bucket for raw diffs and PR bodies (created by capture/s3-bucket.sh)
S3_BUCKET=kepa-raw-your-account-id

# ── GitHub ───────────────────────────────────────────────────────────
# Webhook secret configured in GitHub repo settings > Webhooks
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
